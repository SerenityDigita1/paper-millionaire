# Beehiiv — for email capture
# API key: app.beehiiv.com → Settings → API
BEEHIIV_API_KEY=your_beehiiv_api_key

# Publication ID: app.beehiiv.com → Settings → Publication → scroll to API
BEEHIIV_PUBLICATION_ID=pub_xxxxxxxxxxxxxxxxxxxx

# Amazon Associates tracking tag (public — used client-side on book/desk-gear links only)
# NEXT_PUBLIC_AMAZON_TAG=Digijohn-20
